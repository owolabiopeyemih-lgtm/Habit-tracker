{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "node scripts/generate-og.mjs && npm run build --workspace=client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
